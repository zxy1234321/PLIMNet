{
  "model": {
    "text_model": "dmis-lab/biobert-base-cased-v1.2",
    "hidden_dim": 256,
    "dropout": 0.5,
    "attention_heads": 4,
    "attention_dropout": 0.3,
    "text_unfreeze_layers": 2
  },
  "data": {
    "image_size": 224,
    "box_scale": 1.75,
    "min_box_size": 48,
    "max_text_length": 256
  },
  "training": {
    "epochs": 100,
    "batch_size": 4,
    "num_workers": 4,
    "learning_rate": 0.00005,
    "text_learning_rate": 0.000005,
    "weight_decay": 0.0001,
    "warmup_epochs": 5,
    "warmup_start_factor": 0.2,
    "min_learning_rate": 0.000001,
    "lineage_loss_weight": 0.4,
    "seed": 42,
    "amp": true
  }
}
